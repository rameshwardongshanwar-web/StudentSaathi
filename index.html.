<section id="my-tasks">
  <h2>My Study Tasks ✨</h2>
  <input id="taskInput" placeholder="Enter your study task">
  <button id="addTask">+ Add Task</button>
  <ul id="taskList"></ul>
</section>

<section class="progress-dashboard" id="taskProgress">
  <span class="section-kicker">YOUR PROGRESS</span>
  <h2>You're moving forward! 🚀</h2>
  <p class="progress-subtitle">Every small step counts.</p>

  <div class="progress-cards">
    <div class="progress-card">
      <span class="progress-icon">📋</span>
      <p>Total Tasks</p>
      <h3 id="totalTaskCount">0</h3>
    </div>

    <div class="progress-card">
      <span class="progress-icon">✅</span>
      <p>Completed</p>
      <h3 id="completedTaskCount">0</h3>
    </div>

    <div class="progress-card">
      <span class="progress-icon">⏳</span>
      <p>Pending</p>
      <h3 id="pendingTaskCount">0</h3>
    </div>
  </div>
</section>

<section class="focus-timer" id="focusTimer">
  <span class="section-kicker">FOCUS MODE</span>
  <h2>Time to Focus! 🎯</h2>
  <p>One session. One goal. Your best effort.</p>

  <div class="timer-circle">
    <div id="timerDisplay">30:00</div>
    <span>MINUTES OF FOCUS</span>
  </div>

  <div class="timer-buttons">
    <button id="startTimer">▶ Start</button>
    <button id="pauseTimer">⏸ Pause</button>
    <button id="resetTimer">↻ Reset</button>
  </div>

  <p id="timerMessage">Ready when you are ✨</p>
</section>

<section class="break-panel" id="breakPanel">
  <h2>☕ Study Break</h2>
  <p>Great work! Take a little break and refresh your mind.</p>

  <div id="breakDisplay">05:00</div>

  <button id="startBreak">▶ Start 5-Minute Break</button>
  <button id="resetBreak">↻ Reset Break</button>

  <p id="breakMessage">Your break is ready when you are.</p>
</section>

<section class="notes-section" id="notesSection">
  <span class="section-kicker">YOUR KNOWLEDGE SPACE</span>
  <h2>Smart Study Notes 📚</h2>
  <p>Capture your ideas. Keep your learning organised.</p>

  <div class="notes-form">
    <input
      id="noteTitle"
      type="text"
      placeholder="Enter note title..."
    >

    <textarea
      id="noteContent"
      placeholder="Write your study notes here..."
      rows="5"
    >/textarea>

    <button id="saveNote">＋ Save Note</button>
  </div>

  <p id="notesMessage">Your notes will appear below.</p>
  

  <div id="notesList"></div>
</section>
